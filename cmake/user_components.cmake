# Discover user component sources and include directories under Core/Src/components

set(USER_COMPONENTS_DIR "${CMAKE_CURRENT_LIST_DIR}/../Core/Src/components")

unset(USER_COMPONENTS_SOURCES)
unset(USER_COMPONENTS_INCLUDE_DIRS)

if(EXISTS "${USER_COMPONENTS_DIR}")
    file(GLOB_RECURSE USER_COMPONENTS_SOURCES CONFIGURE_DEPENDS
        "${USER_COMPONENTS_DIR}/*.c"
    )

    file(GLOB_RECURSE USER_COMPONENTS_HEADERS CONFIGURE_DEPENDS
        "${USER_COMPONENTS_DIR}/*.h"
    )

    foreach(_hdr ${USER_COMPONENTS_HEADERS})
        get_filename_component(_dir "${_hdr}" DIRECTORY)
        list(APPEND USER_COMPONENTS_INCLUDE_DIRS "${_dir}")
    endforeach()
    list(REMOVE_DUPLICATES USER_COMPONENTS_INCLUDE_DIRS)
endif()

set(USER_COMPONENTS_SOURCES ${USER_COMPONENTS_SOURCES} PARENT_SCOPE)
set(USER_COMPONENTS_INCLUDE_DIRS ${USER_COMPONENTS_INCLUDE_DIRS} PARENT_SCOPE)
